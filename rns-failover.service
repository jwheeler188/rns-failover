[Unit]
Description=Reticulum uplink failover watchdog
# Start after rnsd. The watchdog waits by itself until the shared instance
# answers, so a readiness gate is optional. If you use reticulum-readygate,
# replace the two lines below with:
#   After=reticulum-ready.service
#   Requires=reticulum-ready.service
After=reticulum.service
Wants=reticulum.service

[Service]
# List your uplink interfaces with --tier, highest priority first. Each name
# must match the [[section name]] of the interface in your Reticulum config.
# Every tier except the first should be set to "enabled = false" in that
# config; the watchdog attaches them only when the tiers above are down.
ExecStart=/usr/bin/python3 /home/svcuser/.local/bin/rns-failover.py \
    --rnstatus /home/svcuser/.local/bin/rnstatus \
    --tier "Primary Hub" \
    --tier "Secondary Hub" \
    --tier "Fallback Hub"
Restart=always
RestartSec=10
User=svcuser

[Install]
WantedBy=multi-user.target
